# Environment Variables — Rohit Pandey Portfolio Server
# Copy this file to .env and fill in values before running the server.
# Never commit .env to version control.

# MongoDB connection string
# Local:   mongodb://localhost:27017/portfolio
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/portfolio
MONGO_URI=mongodb://localhost:27017/portfolio

# Express server port
# Use 5001 if port 5000 is occupied (macOS sometimes uses 5000 for AirPlay/system services)
PORT=5001

# CP stats cache TTL in minutes (how long before the endpoint re-fetches live data)
CACHE_TTL_MINUTES=15

# CORS — URL of the React dev server (update to your production domain when deploying)
CLIENT_URL=http://localhost:5173
